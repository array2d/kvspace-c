+int kvspaceShmViewSweep(kvspace_t *kv) {
+    if (!kv || kv->hdr->art_root < 0)
+        return 0;
+    p2_reg_ack(kv);
+    p2_barrier(kv);                 /* 死 owner 的代推进 + 槽回收 */
+    return p2_sweep_node(kv, kv->hdr->art_root);
+}
