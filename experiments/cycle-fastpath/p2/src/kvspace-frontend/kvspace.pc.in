prefix=@CMAKE_INSTALL_PREFIX@
exec_prefix=${prefix}
libdir=${prefix}/@CMAKE_INSTALL_LIBDIR@
includedir=${prefix}/@CMAKE_INSTALL_INCLUDEDIR@

Name: kvspace
Description: KVSpace dispatch frontend (shm:// → libkvspace-c, redis/fs/s3 → libkvspace_durable)
Version: @PROJECT_VERSION@
Libs: -L${libdir} -lkvspace
Cflags: -I${includedir}
